{
  "manifest_version": 3,
  "name": "PhishGuard Colombia - Detector de Phishing y Fraude",
  "version": "1.0.0",
  "description": "Protección en tiempo real contra sitios fraudulentos y suplantación de identidad en Colombia.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/paginas/emergente/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "trabajador-servicio.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inspector-documento.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/paginas/opciones/index.html",
  "permissions": [
    "webNavigation",
    "storage",
    "tabs"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
