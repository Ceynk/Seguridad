{
  "name": "phishguard-colombia",
  "version": "1.0.0",
  "description": "Extensión de navegador para detección, advertencia y bloqueo de sitios fraudulentos y phishing en Colombia",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,html,css}\""
  },
  "keywords": [
    "ciberseguridad",
    "phishing",
    "extension",
    "chrome",
    "manifest-v3",
    "colombia",
    "seguridad"
  ],
  "author": "PhishGuard Team",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.304",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
